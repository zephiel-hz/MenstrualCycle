# Neon Serverless PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@localhost:5432/lunara?sslmode=require"

# JWT Secret for session cookie encryption (min 32 characters)
AUTH_SECRET="lunara_super_secret_auth_key_must_be_32_characters_minimum"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
